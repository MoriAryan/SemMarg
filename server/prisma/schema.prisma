datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URI")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String       @id @default(cuid())
  clerkId    String       @unique
  email      String       @unique
  name       String?
  subjects   Subject[]
  tasks      Task[]
  attendance Attendance[]
  createdAt  DateTime     @default(now())
}

model Subject {
  id         String       @id @default(cuid())
  name       String
  type       SubjectType
  color      String // Auto-assigned accent color
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks      Task[]
  attendance Attendance[]
  createdAt  DateTime     @default(now())

  @@unique([userId, name])
}

model Task {
  id          String    @id @default(cuid())
  name        String
  description String?
  deadline    DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Attendance {
  id        String   @id @default(cuid())
  date      DateTime
  status    String   // "P" or "A"
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([subjectId, date])
  @@index([userId])
}

enum SubjectType {
  LAB
  TUTORIAL
}

